@model MYAcedemy_IdentityEmailProject.Models.UserLoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Giriş Yap | Mailora</title>
</head>
<body>
    <main class="login-card">
        <p class="brand">Mailora</p>

        <h1>Giriş Yap</h1>

        <form asp-controller="Login" asp-action="SignIn" method="post">
            <div asp-validation-summary="ModelOnly" class="error"></div>

            <div class="field">
                <label asp-for="UserName">Kullanıcı adı</label>
                <input asp-for="UserName" autocomplete="username" required />
                <span asp-validation-for="UserName" class="error"></span>
            </div>

            <div class="password-field">
                <input asp-for="Password" type="password"
                       autocomplete="current-password" required />

                <button type="button" id="togglePassword"
                        aria-label="Şifreyi göster" title="Şifreyi göster">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <p class="forgot-password">
                <a asp-controller="Login" asp-action="ForgotPassword">
                    Şifremi unuttum
                </a>
            </p>      
            <button type="submit">Giriş Yap</button>
            @if (TempData["PasswordResetSuccess"] is string message)
            {
                <p class="reset-notice" role="status">@message</p>
            }
        </form>
        <p class="register">
            Hesabın yok mu?
            <a asp-controller="Register" asp-action="SignUp">Kayıt Ol</a>
        </p>
    </main>
</body>
</html>
@await Component.InvokeAsync("_LoginLayoutStyleComponentPartial")
@await Component.InvokeAsync("_LoginLayoutScriptComponentPartial")