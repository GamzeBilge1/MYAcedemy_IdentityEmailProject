@model MYAcedemy_IdentityEmailProject.Models.UserLoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Giriş Yap | Mailora</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100dvh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: radial-gradient(ellipse at top, #e9ddff, #f8f5ff 65%);
            color: #241a32;
            font-family: system-ui, sans-serif;
        }

        .login-card {
            width: min(100%, 390px);
            padding: clamp(24px, 6vw, 36px);
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 16px 40px #31245d1a;
        }

        .brand {
            margin: 0 0 24px;
            color: #6943ab;
            font-weight: 750;
        }

        h1 {
            margin: 0 0 22px;
            font-size: 1.75rem;
        }

        .field {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-size: .875rem;
            font-weight: 600;
        }

        input, button {
            width: 100%;
            min-height: 46px;
            border-radius: 8px;
            font: inherit;
        }

        input {
            padding: 10px 12px;
            border: 1px solid #d8d0e2;
            background: #fcfaff;
        }

        button {
            border: 0;
            background: #5c3699;
            color: #fff;
            font-weight: 650;
            cursor: pointer;
        }

        :focus-visible {
            outline: 2px solid #7952bb;
            outline-offset: 3px;
        }

        .register {
            margin: 22px 0 0;
            text-align: center;
            font-size: .875rem;
        }

        a {
            color: #5c3699;
            font-weight: 650;
        }

        .error {
            color: #b42318;
            font-size: .875rem;
        }
    </style>
</head>
<body>
    <main class="login-card">
        <p class="brand">Mailora</p>
        <h1>Giriş Yap</h1>

        <form asp-controller="Login" asp-action="SignIn" method="post">
            <div asp-validation-summary="ModelOnly" class="error"></div>

            <div class="field">
                <label asp-for="UserName">Kullanıcı adı</label>
                <input asp-for="UserName" autocomplete="username" required />
                <span asp-validation-for="UserName" class="error"></span>
            </div>

            <div class="field">
                <label asp-for="Password">Şifre</label>
                <input asp-for="Password" type="password"
                       autocomplete="current-password" required />
                <span asp-validation-for="Password" class="error"></span>
            </div>

            <button type="submit">Giriş Yap</button>
        </form>

        <p class="register">
            Hesabın yok mu?
            <a asp-controller="Register" asp-action="SignUp">Kayıt Ol</a>
        </p>
    </main>
</body>
</html>