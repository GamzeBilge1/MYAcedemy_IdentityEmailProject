@model MYAcedemy_IdentityEmailProject.Models.ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Şifremi unuttum | Mailora</title>
    @await Component.InvokeAsync("_LoginLayoutStyleComponentPartial")
</head>
<body>
    <main class="login-card">
        <p class="brand">Mailora</p>
        <h1>Şifremi unuttum</h1>
        <p>Şifre yenileme bağlantısı için e-posta adresinizi girin.</p>

        <form  method="post">
            <div class="field">
                <label asp-for="Email">E-posta adresi</label>
                <input asp-for="Email" type="email" autocomplete="email" required />
                <span asp-validation-for="Email" class="error"></span>
            </div>

            <button type="submit">Bağlantı gönder</button>
        </form>
        @if (ViewData["ResetMessage"] is string message)
        {
            <div class="reset-notice" role="status">
                <strong>E-postanızı kontrol edin</strong>
                <p>@message</p>
            </div>
        }

        <p class="register">
            <a asp-action="SignIn">Giriş ekranına dön</a>
        </p>
    </main>
</body>
</html>