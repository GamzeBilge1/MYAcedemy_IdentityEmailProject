@model MYAcedemy_IdentityEmailProject.Models.ResetPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Şifreyi yenile | Mailora</title>
    @await Component.InvokeAsync("_LoginLayoutStyleComponentPartial")
</head>
<body>
    <main class="login-card">
        <h1>Yeni şifre belirle</h1>

        <form method="post">
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="error"></div>

            <div class="field">
                <label asp-for="Password">Yeni şifre</label>
                <div class="password-field">
                    <input asp-for="Password" type="password"
                           autocomplete="new-password" required />
                    <button type="button" class="password-toggle" data-eye="Password"
                            aria-label="Yeni şifreyi göster">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="error"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword">Yeni şifre tekrar</label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" type="password"
                           autocomplete="new-password" required />
                    <button type="button" class="password-toggle" data-eye="ConfirmPassword"
                            aria-label="Şifre tekrarını göster">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="error"></span>
            </div>

            <button type="submit">Şifreyi kaydet</button>
        </form>
    </main>

    @await Component.InvokeAsync("_LoginLayoutScriptComponentPartial")
</body>
</html>