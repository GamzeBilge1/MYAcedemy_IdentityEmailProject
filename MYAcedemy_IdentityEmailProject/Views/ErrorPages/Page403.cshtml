@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>403 — Erişim izni yok | Mailora</title>


</head>
<body>
    <main class="error-page">
        <img class="error-image"
             src="~/images/mailora-403.png"
             width="1536"
             height="1024"
             alt="403" />

        <h1>Erişim izniniz yok</h1>
        <p class="description">Hesabınızın bu sayfayı görüntüleme yetkisi yok.</p>

        <a class="home-link" asp-controller="Message" asp-action="Inbox">
            Ana sayfaya dön <span aria-hidden="true">→</span>
        </a>
    </main>
</body>
</html>
@await Component.InvokeAsync("_ErrorLayoutStyleComponentPartial")