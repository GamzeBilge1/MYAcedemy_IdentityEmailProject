@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Sayfa bulunamadı | Mailora</title>


</head>
<body>
    <main class="error-page">
        <img class="error-image"
             src="~/images/mailora-404.png"
             width="1536" height="1024"
             alt="404" />

        <h1>Sayfa bulunamadı</h1>
        <p class="description">Adresi kontrol edin veya ana sayfaya dönün.</p>

        <a class="home-link" asp-controller="Message" asp-action="Inbox">
            Ana sayfaya dön <span aria-hidden="true">→</span>
        </a>
    </main>
</body>
</html>
@await Component.InvokeAsync("_ErrorLayoutStyleComponentPartial")