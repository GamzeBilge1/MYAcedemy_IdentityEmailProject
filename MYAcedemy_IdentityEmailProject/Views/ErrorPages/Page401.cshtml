@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>401 — Giriş gerekli | Mailora</title>

</head>
<body>
    <main class="error-page">
        <img class="error-image"
             src="~/images/mailora-401.png"
             width="1536" height="1024"
             alt="401" />

        <h1>Giriş yapmanız gerekiyor</h1>
        <p class="description">Bu sayfayı görmek için hesabınıza giriş yapın.</p>

        <a class="home-link" asp-controller="Login" asp-action="SignIn">
            Giriş yap <span aria-hidden="true">→</span>
        </a>
    </main>
</body>
</html>

@await Component.InvokeAsync("_ErrorLayoutStyleComponentPartial")