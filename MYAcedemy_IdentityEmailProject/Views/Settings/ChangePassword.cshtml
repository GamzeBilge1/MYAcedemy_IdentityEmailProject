@model MYAcedemy_IdentityEmailProject.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Şifre değiştir";
    ViewData["ActiveMenu"] = "settings";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var fullName = ViewBag.FullName as string;
    var userName = ViewBag.UserName as string;
    var email = ViewBag.Email as string;

    var displayName = string.IsNullOrWhiteSpace(fullName)
        ? (string.IsNullOrWhiteSpace(userName) ? "Kullanıcı" : userName)
        : fullName;

    var initials = string.Concat(
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]))
        .ToUpper(new System.Globalization.CultureInfo("tr-TR"));
}

<section aria-labelledby="settings-title">
    <h1 id="settings-title" class="h4 mb-3">Ayarlar</h1>

    <div class="row g-3 align-items-start">
        <div class="col-12 col-lg-7">
            <div class="panel p-4 w-100">
                <h2 class="h5 mb-2">Şifre değiştir</h2>
                <p class="text-muted small mb-4">
                    Mevcut şifrenizi girin ve yeni bir şifre belirleyin.
                </p>

                @if (TempData["PasswordChanged"] is string message)
                {
                    <div class="alert alert-success" role="status">@message</div>
                }

                <form asp-controller="Settings" asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Mevcut şifre</label>

                        <div class="position-relative">
                            <input asp-for="CurrentPassword" class="form-control pe-5"
                                   type="password" autocomplete="current-password" required />

                            <button type="button"
                                    class="btn position-absolute top-50 end-0 translate-middle-y"
                                    data-eye="CurrentPassword" aria-label="Şifreyi göster"
                                    title="Şifreyi göster">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>

                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Yeni şifre</label>

                        <div class="position-relative">
                            <input asp-for="NewPassword" class="form-control pe-5"
                                   type="password" autocomplete="new-password" required />

                            <button type="button"
                                    class="btn position-absolute top-50 end-0 translate-middle-y"
                                    data-eye="NewPassword" aria-label="Şifreyi göster"
                                    title="Şifreyi göster">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>

                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Yeni şifre tekrar</label>

                        <div class="position-relative">
                            <input asp-for="ConfirmPassword" class="form-control pe-5"
                                   type="password" autocomplete="new-password" required />

                            <button type="button"
                                    class="btn position-absolute top-50 end-0 translate-middle-y"
                                    data-eye="ConfirmPassword" aria-label="Şifreyi göster"
                                    title="Şifreyi göster">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn text-white px-3"
                            style="background-color: var(--accent-dark);">
                        Şifreyi değiştir
                    </button>
                </form>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="panel p-4">
                <h2 class="h5 mb-3">Hesabım</h2>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="rounded-circle d-grid flex-shrink-0 fw-bold"
                          style="width: 56px; height: 56px; place-items: center;
                                 background: #eae4fb; color: var(--accent-dark);"
                          aria-hidden="true">
                        @initials
                    </span>

                    <div>
                        <p class="fw-semibold mb-1">@displayName</p>

                        @if (ViewBag.EmailConfirmed == true)
                        {
                            <span class="d-inline-block rounded-pill px-2 py-1 small fw-semibold"
                                  style="background: #e6f5eb; color: #21633d;">
                                <span aria-hidden="true">✓</span> Doğrulandı
                            </span>
                        }
                    </div>
                </div>

                <hr />

                <dl class="mb-0">
                    <dt>Kullanıcı adı</dt>
                    <dd class="text-break">@userName</dd>

                    <dt>E-posta</dt>
                    <dd class="text-break mb-0">@email</dd>
                </dl>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    @await Component.InvokeAsync("_LoginLayoutScriptComponentPartial")
}