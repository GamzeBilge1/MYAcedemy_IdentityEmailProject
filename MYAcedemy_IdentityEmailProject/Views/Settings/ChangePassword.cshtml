@model MYAcedemy_IdentityEmailProject.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Ayarlar";
    ViewData["ActiveMenu"] = "settings";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var fullName = ViewBag.FullName as string;
    var userName = ViewBag.UserName as string;
    var imageUrl = ViewBag.ImageUrl as string;

    var displayName = !string.IsNullOrWhiteSpace(fullName)
        ? fullName.Trim()
        : (!string.IsNullOrWhiteSpace(userName) ? userName.Trim() : "Kullanıcı");

    var initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => part[0]))
        .ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}

<style>
    .account-settings .settings-card {
        border: 1px solid var(--border, #e9e5f4);
        border-radius: 20px;
        background: #fff;
    }

    .account-settings .settings-profile {
        padding: 28px 20px;
        background: linear-gradient(150deg, #f2edff, #fff 85%);
        text-align: center;
    }

    .account-settings .settings-avatar {
        display: grid;
        place-items: center;
        width: 96px;
        height: 96px;
        margin: 0 auto 16px;
        overflow: hidden;
        border: 4px solid #fff;
        border-radius: 50%;
        background: #e8dffd;
        color: #59469f;
        box-shadow: 0 6px 18px rgba(89, 70, 159, .15);
    }

        .account-settings .settings-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .account-settings .settings-lock {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #eee8fb;
        color: #59469f;
    }

    .account-settings .settings-divider {
        border-color: var(--border, #e9e5f4) !important;
    }

    .account-settings .form-control {
        min-height: 46px;
        border-color: #e3deee;
        border-radius: 12px;
        background: #fcfbfe;
    }

        .account-settings .form-control:focus {
            border-color: #8976ce;
            box-shadow: 0 0 0 3px rgba(137, 118, 206, .16);
        }

    .account-settings [data-eye] {
        color: #6956b2;
    }

    .account-settings .settings-save {
        background: #6956b2;
        color: #fff;
    }

        .account-settings .settings-save:hover,
        .account-settings .settings-save:focus-visible {
            background: #59469f;
            color: #fff;
        }
</style>

<section class="account-settings pt-3 pb-4" aria-labelledby="settings-title">
    <h1 id="settings-title" class="h3 fw-bold mb-4">Ayarlar</h1>

    <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-4 col-xl-3">
            <aside class="settings-card settings-profile" aria-label="Profil bilgileri">
                <div class="settings-avatar fs-3 fw-bold">
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img src="@Url.Content(imageUrl)" alt="Profil fotoğrafı" />
                    }
                    else
                    {
                        <span aria-hidden="true">@initials</span>
                    }
                </div>

                <h2 class="h5 fw-bold mb-1 text-break">@displayName</h2>

                @if (!string.IsNullOrWhiteSpace(userName))
                {
                    <p class="small text-muted mb-0 text-break">@($"@{userName}")</p>
                }
            </aside>
        </div>

        <div class="col-12 col-lg-8 col-xl-9">
            <section class="settings-card" aria-labelledby="password-title">
                <header class="d-flex align-items-center gap-3 p-3 p-md-4 border-bottom settings-divider">
                    <span class="settings-lock" aria-hidden="true">
                        <i class="bi bi-shield-lock fs-5"></i>
                    </span>

                    <div>
                        <h2 id="password-title" class="h5 fw-bold mb-1">Şifreyi değiştir</h2>
                        <p class="small text-muted mb-0">
                            Mevcut şifrenizi girin ve yeni bir şifre belirleyin.
                        </p>
                    </div>
                </header>

                <form asp-controller="Settings" asp-action="ChangePassword"
                      method="post" class="p-3 p-md-4">

                    @if (TempData["PasswordChanged"] is string message)
                    {
                        <div class="alert alert-success rounded-3" role="status">@message</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold">
                                Mevcut şifre
                            </label>

                            <div class="position-relative">
                                <input asp-for="CurrentPassword" type="password"
                                       class="form-control pe-5"
                                       autocomplete="current-password" required />

                                <button type="button" data-eye="CurrentPassword"
                                        class="btn position-absolute top-50 end-0 translate-middle-y"
                                        aria-label="Mevcut şifreyi göster" title="Şifreyi göster">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>

                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="NewPassword" class="form-label fw-semibold">
                                Yeni şifre
                            </label>

                            <div class="position-relative">
                                <input asp-for="NewPassword" type="password"
                                       class="form-control pe-5"
                                       autocomplete="new-password" required />

                                <button type="button" data-eye="NewPassword"
                                        class="btn position-absolute top-50 end-0 translate-middle-y"
                                        aria-label="Yeni şifreyi göster" title="Şifreyi göster">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>

                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                Yeni şifre tekrarı
                            </label>

                            <div class="position-relative">
                                <input asp-for="ConfirmPassword" type="password"
                                       class="form-control pe-5"
                                       autocomplete="new-password" required />

                                <button type="button" data-eye="ConfirmPassword"
                                        class="btn position-absolute top-50 end-0 translate-middle-y"
                                        aria-label="Yeni şifre tekrarını göster" title="Şifreyi göster">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <footer class="d-flex justify-content-end mt-4 pt-3 border-top settings-divider">
                        <button type="submit" class="btn settings-save rounded-pill px-4 fw-semibold">
                            Şifreyi değiştir
                        </button>
                    </footer>
                </form>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    @await Component.InvokeAsync("_LoginLayoutScriptComponentPartial")
}