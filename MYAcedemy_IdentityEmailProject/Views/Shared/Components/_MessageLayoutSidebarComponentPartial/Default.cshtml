<!-- =====================================================================
      SHARED SIDEBAR
      ASP.NET Core MVC: Views/Shared/_Sidebar.cshtml (partial) — _Layout.cshtml içinde
      Menü linkleri ileride asp-controller / asp-action ile değiştirilecek.
      ===================================================================== -->
<aside class="app-sidebar" id="appSidebar" aria-label="Ana menü">
    <a class="brand" data-page="inbox" href="#inbox">
        <div class="brand-logo"><i class="bi bi-envelope-paper-heart-fill"></i></div>
        <div class="brand-name">Mail<span>ora</span></div>
    </a>

    <a class="btn-compose" data-page="compose"
       href="/Message/CreateMessage" data-tip="Yeni Mesaj">
        <i class="bi bi-pencil-square"></i>
        <span class="lbl">Yeni Mesaj</span>
    </a>
    <div class="nav-section-title">Menü</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="dashboard" href="#dashboard" data-tip="Dashboard"><i class="bi bi-grid-1x2"></i> <span class="lbl">Dashboard</span></a></li>
        <li><a class="side-link" data-page="inbox" href="/Message/Inbox" data-tip="Gelen Kutusu"><i class="bi bi-inbox"></i> <span class="lbl">Gelen Kutusu</span> <span class="side-badge" id="badgeInbox"></span></a></li>
        <li><a class="side-link" data-page="sent" href="/Message/Sendbox" data-tip="Gönderilenler"><i class="bi bi-send"></i> <span class="lbl">Gönderilenler</span></a></li>
        <li>
            <a class="side-link" data-page="drafts"
               asp-controller="Message" asp-action="Drafts" data-tip="Taslaklar">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span class="lbl">Taslaklar</span>
                <span class="side-badge muted">@ViewBag.DraftCount</span>
            </a>
        </li>
            <a class="side-link" data-page="starred" href="/Message/Starred"
               data-tip="Yıldızlı Mesajlar">
                <i class="bi bi-star"></i>
                <span class="lbl">Yıldızlı Mesajlar</span>
                <span class="side-badge muted" id="badgeStarred"
                      data-inbox-count="@ViewBag.InboxStarredCount"
                      data-sent-count="@ViewBag.SentStarredCount">
                    @(ViewBag.InboxStarredCount + ViewBag.SentStarredCount)
                </span>
            </a>
        </li>
        <li><a class="side-link" data-page="trash" href="/Message/Trash" data-tip="Çöp Kutusu"><i class="bi bi-trash3"></i> <span class="lbl">Çöp Kutusu</span> <span class="side-badge muted" id="badgeTrash"></span></a></li>
    </ul>

    <div class="nav-section-title">Hesap</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="profile" href="/Profile/Edit" data-tip="Profilim"><i class="bi bi-person-circle"></i> <span class="lbl">Profilim</span></a></li>
        <li><a class="side-link" data-page="settings" asp-controller="Settings" asp-action="ChangePassword" data-tip="Ayarlar"><i class="bi bi-gear"></i> <span class="lbl">Ayarlar</span></a></li>
    </ul>

    <div class="nav-section-title">Etiketler</div>
    <ul class="side-labels">
        <li><a data-label="İş" data-tip="İş"><span class="dot" style="background:#8B7FD6"></span> <span class="lbl">İş</span></a></li>
        <li><a data-label="Kişisel" data-tip="Kişisel"><span class="dot" style="background:#5CC09A"></span> <span class="lbl">Kişisel</span></a></li>
        <li><a data-label="Fatura" data-tip="Fatura"><span class="dot" style="background:#EBA27A"></span> <span class="lbl">Fatura</span></a></li>
    </ul>

    <div class="storage-card" data-tip="Depolama · 9,3 / 15 GB">
        <div class="top">
            <div class="ic"><i class="bi bi-cloud"></i></div>
            <div>
                <div class="t1">Depolama</div>
                <div class="t2">9,3 GB / 15 GB kullanıldı</div>
            </div>
        </div>
        <div class="storage-bar"><span></span></div>
    </div>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<!-- /SHARED SIDEBAR -->
