@using Microsoft.AspNetCore.Identity
@using MYAcedemy_IdentityEmailProject.Entities
@inject UserManager<AppUser> NavbarUserManager

@{
    var user = await NavbarUserManager.GetUserAsync(User);
    var fullName = $"{user?.Name} {user?.SurName}".Trim();
    var userName = user?.UserName;
    var email = user?.Email;
    var imageUrl = user?.ImageUrl;

    var displayName = !string.IsNullOrWhiteSpace(fullName)
        ? fullName
        : (!string.IsNullOrWhiteSpace(userName) ? userName : "Kullanıcı");

    var initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => part[0]))
        .ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}

<style>
    .app-navbar .account-avatar {
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 50%;
    }

        .app-navbar .account-avatar img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
</style>

<header class="app-navbar">
    <button class="nav-toggle" id="sidebarToggle" type="button"
            aria-label="Menüyü daralt / genişlet" title="Menüyü daralt">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>

    <div class="global-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" id="globalSearch"
               placeholder="Mesajlarda, kişilerde ara…" autocomplete="off">
        <span class="kbd">Ctrl K</span>
    </div>

    <div class="nav-actions">
        <button class="icon-btn hide-xs" type="button" title="Yardım">
            <i class="bi bi-question-circle" aria-hidden="true"></i>
        </button>

        <div class="dropdown">
            <button class="icon-btn" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false" title="Bildirimler">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="pip"></span>
            </button>

            <div class="dropdown-menu dropdown-menu-end notif-menu">
                <div class="d-flex justify-content-between align-items-center px-2 pt-1 pb-2">
                    <strong style="font-size: 14px;">Bildirimler</strong>
                    <span class="tag tag-is">3 yeni</span>
                </div>
                <div class="notif-item">
                    <div class="ni av-lav"><i class="bi bi-envelope"></i></div>
                    <div>
                        <div class="nt">Ayşe Demir size mesaj gönderdi</div>
                        <div class="nd">5 dakika önce</div>
                    </div>
                </div>
                <div class="notif-item">
                    <div class="ni av-mint"><i class="bi bi-calendar-check"></i></div>
                    <div>
                        <div class="nt">Sprint toplantısı 14:00'te başlıyor</div>
                        <div class="nd">30 dakika önce</div>
                    </div>
                </div>
                <div class="notif-item">
                    <div class="ni av-blue"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <div class="nt">Yeni cihazdan giriş yapıldı</div>
                        <div class="nd">Dün, 22:14</div>
                    </div>
                </div>
            </div>
        </div>

        @if (user != null)
        {
            <div class="dropdown">
                <button class="user-chip" type="button" data-bs-toggle="dropdown"
                        aria-expanded="false" aria-label="Hesap menüsü">
                    <span class="avatar sm av-user account-avatar" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <img src="@Url.Content(imageUrl)" alt="" />
                        }
                        else
                        {
                            @initials
                        }
                    </span>

                    <span class="meta">
                        <span class="name d-block">@displayName</span>
                        @if (!string.IsNullOrWhiteSpace(userName))
                        {
                            <span class="role d-block">@($"@{userName}")</span>
                        }
                    </span>

                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li class="dd-head">
                        <span class="avatar av-user account-avatar" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@Url.Content(imageUrl)" alt="" />
                            }
                            else
                            {
                                @initials
                            }
                        </span>

                        <div class="text-break" style="min-width: 0;">
                            <div class="fw-bold">@displayName</div>
                            @if (!string.IsNullOrWhiteSpace(email))
                            {
                                <div style="font-size: 12.5px; color: var(--muted);">@email</div>
                            }
                        </div>
                    </li>

                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" asp-controller="Profile" asp-action="Edit">
                            <i class="bi bi-person" aria-hidden="true"></i> Profilim
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Settings" asp-action="ChangePassword">
                            <i class="bi bi-gear" aria-hidden="true"></i> Ayarlar
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#"
                           onclick="showToast('Tema seçenekleri yakında eklenecek.', 'bi-palette'); return false;">
                            <i class="bi bi-moon-stars" aria-hidden="true"></i> Görünüm
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Login" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item danger">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Çıkış Yap
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
    </div>
</header>