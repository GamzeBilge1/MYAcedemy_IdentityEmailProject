@model List<MYAcedemy_IdentityEmailProject.Entities.MessageDraft>
@using System.Globalization
@using System.Net
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = "Taslaklar";
    ViewData["ActiveMenu"] = "drafts";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    const int pageSize = 10;
    var initialPageCount = Math.Max(1, (Model.Count + pageSize - 1) / pageSize);
    var rowIndex = 0;
    var culture = CultureInfo.GetCultureInfo("tr-TR");
    var avatarColors = new[] { "av-lav", "av-blue", "av-mint", "av-rose", "av-peach" };
}

<section class="inbox" aria-labelledby="draftTitle">
    <div class="panel list-panel">
        <header class="list-head">
            <div class="list-title">
                <div>
                    <h1 id="draftTitle">Taslaklar</h1>
                    <div class="sub">@Model.Count taslak</div>
                </div>
            </div>
            <div class="list-tools">
                <div class="list-search" id="draftSearchWrap">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="draftSearch" type="search" placeholder="Alıcı, konu veya içerik ara"
                           aria-label="Taslaklarda ara" autocomplete="off" />
                    <button class="clear" id="draftSearchClear" type="button" aria-label="Aramayı temizle">
                        <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </header>

        <form id="draftListForm" asp-controller="Message" asp-action="DeleteDrafts" method="post"></form>

        <div class="bulk-bar">
            <input type="checkbox" class="m-check" id="draftCheckAll" aria-label="Görünen taslakların tümünü seç" />
            <span class="sel-info" id="draftSelection">Tümünü seç</span>
            <span class="spacer"></span>
            <button type="submit" class="tool-btn" id="deleteDrafts" form="draftListForm" disabled
                    title="Seçili taslakları sil" aria-label="Seçili taslakları sil">
                <i class="bi bi-trash3" aria-hidden="true"></i>
            </button>
            <button type="button" class="tool-btn" id="sortDrafts"
                    title="Tarih sırası: En yeni" aria-label="Tarih sırası: En yeni">
                <i class="bi bi-arrow-down-up" aria-hidden="true"></i>
            </button>
        </div>

        <div class="msg-list" id="draftRows">
            @foreach (var draft in Model.OrderByDescending(d => d.UpdatedAt).ThenByDescending(d => d.MessageDraftId))
            {
                var receiver = string.IsNullOrWhiteSpace(draft.ReceiverEmail) ? "Alıcı belirtilmedi" : draft.ReceiverEmail;
                var subject = string.IsNullOrWhiteSpace(draft.Subject) ? "Konusuz" : draft.Subject;
                var text = WebUtility.HtmlDecode(Regex.Replace(draft.MessageDetail ?? "", "<[^>]+>", " "));
                var preview = Regex.Replace(text, @"\s+", " ").Trim();
                var localDate = DateTime.SpecifyKind(draft.UpdatedAt, DateTimeKind.Utc).ToLocalTime();

                <article class="msg-item" hidden="@(rowIndex++ >= pageSize)" data-search="@($"{receiver} {subject} {preview}".ToLower(culture))">
                    <div class="lead">
                        <input type="checkbox" class="m-check row-check" name="ids" form="draftListForm"
                               value="@draft.MessageDraftId" aria-label="@($"{subject} taslağını seç")" />
                    </div>
                    <span class="avatar @(avatarColors[draft.MessageDraftId % avatarColors.Length])" aria-hidden="true">
                        @(string.IsNullOrWhiteSpace(draft.ReceiverEmail) ? "?" : receiver.Substring(0, 1).ToUpper(culture))
                    </span>
                    <div class="mi-sender"><span class="sender">@receiver</span></div>
                    <div class="mi-main">
                        <a class="subject text-reset text-decoration-none"
                           asp-controller="Message"
                           asp-action="EditDraft"
                           asp-route-id="@draft.MessageDraftId">
                            @subject
                        </a>
                        @if (preview.Length > 0)
                        {
                            <span class="snippet">@(preview.Length > 140 ? preview.Substring(0, 140) + "…" : preview)</span>
                        }
                    </div>
                    <span class="time" title="@localDate.ToString("dd.MM.yyyy HH:mm", culture)">
                        @localDate.ToString("d MMM", culture)
                    </span>
                </article>
            }
            <div id="draftEmpty" class="empty-list p-3 text-center" hidden="@(Model.Count > 0)">
                @(Model.Count == 0 ? "Henüz kaydedilmiş taslağınız yok." : "Aramanıza uygun taslak bulunamadı.")
            </div>

        </div>

        <div class="list-foot">
            <span class="range" id="draftCount">@(Model.Count == 0 ? 0 : 1)–@Math.Min(pageSize, Model.Count) / @Model.Count taslak</span>
            <div class="pager" id="draftPager" aria-label="Taslak sayfaları">
                <button type="button" disabled aria-label="Önceki"><i class="bi bi-chevron-left"></i></button>
                @for (var index = 1; index <= initialPageCount; index++)
                {
                    <button type="button" class="@(index == 1 ? "active" : "")" aria-current="@(index == 1 ? "page" : null)">@index</button>
                }
                <button type="button" disabled="@(initialPageCount == 1)" aria-label="Sonraki"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>
</section>
<dialog id="draftDeleteDialog" aria-labelledby="draftDeleteTitle"
        style="border: 0; border-radius: 20px; padding: 24px; width: min(400px, 90vw);">
    <h5 id="draftDeleteTitle">Taslaklar silinsin mi?</h5>
    <p>Seçili taslaklar kalıcı olarak silinecek.</p>

    <form method="dialog" class="d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-light rounded-pill" autofocus>
            Vazgeç
        </button>
        <button type="submit" form="draftListForm" class="btn rounded-pill text-white"
                style="background: #7767c5;">
            Sil
        </button>
    </form>
</dialog>

<style>
    #draftDeleteDialog::backdrop {
        background: rgba(37, 32, 61, 0.45);
    }
</style>
@section Scripts {
    <script>
        (() => {
            const list = document.getElementById('draftRows');
            const search = document.getElementById('draftSearch');
            const selectAll = document.getElementById('draftCheckAll');
            const deleteButton = document.getElementById('deleteDrafts');
            const sortButton = document.getElementById('sortDrafts');
            const empty = document.getElementById('draftEmpty');
            const pager = document.getElementById('draftPager');
            const searchWrap = document.getElementById('draftSearchWrap');
            const pageSize = @pageSize;
            let page = 1;
            let oldestFirst = false;
                    deleteButton.addEventListener('click', event => {
            event.preventDefault();
            document.getElementById('draftDeleteDialog').showModal();
        });
            const rows = () => [...list.querySelectorAll('.msg-item')];
            const visibleRows = () => rows().filter(row => !row.hidden);
            const checkbox = row => row.querySelector('.row-check');

            function updateSelection() {
                const visible = visibleRows();
                const selected = visible.filter(row => checkbox(row).checked).length;

                selectAll.checked = selected > 0 && selected === visible.length;
                selectAll.indeterminate = selected > 0 && selected < visible.length;
                selectAll.disabled = visible.length === 0;
                deleteButton.disabled = selected === 0;
                document.getElementById('draftSelection').textContent =
                    selected ? selected + ' taslak seçildi' : 'Tümünü seç';
            }

            function renderPager(pageCount) {
                pager.replaceChildren();

                function addPageButton(label, target, disabled, current = false, icon = '') {
                    const button = document.createElement('button');
                    button.type = 'button';
                    if (icon) {
                        const arrow = document.createElement('i');
                        arrow.className = 'bi ' + icon;
                        arrow.setAttribute('aria-hidden', 'true');
                        button.append(arrow);
                        button.setAttribute('aria-label', label);
                    } else {
                        button.textContent = label;
                    }
                    button.disabled = disabled;
                    if (current) {
                        button.classList.add('active');
                        button.setAttribute('aria-current', 'page');
                    }
                    button.addEventListener('click', () => {
                        page = target;
                        renderDrafts();
                    });
                    pager.append(button);
                }

                addPageButton('Önceki', page - 1, page === 1, false, 'bi-chevron-left');
                for (let index = 1; index <= pageCount; index++) {
                    addPageButton(String(index), index, false, index === page);
                }
                addPageButton('Sonraki', page + 1, page === pageCount, false, 'bi-chevron-right');
            }

            function renderDrafts() {
                const query = search.value.trim().toLocaleLowerCase('tr-TR');
                const matches = rows().filter(row => row.dataset.search.includes(query));
                const pageCount = Math.max(1, Math.ceil(matches.length / pageSize));
                page = Math.min(page, pageCount);

                const start = (page - 1) * pageSize;
                const visible = new Set(matches.slice(start, start + pageSize));

                for (const row of rows()) {
                    row.hidden = !visible.has(row);
                    row.classList.toggle('d-none', row.hidden);
                    if (row.hidden) checkbox(row).checked = false;
                }

                empty.hidden = matches.length > 0;
                empty.classList.toggle('d-none', empty.hidden);
                searchWrap.classList.toggle('has-value', Boolean(search.value));
                const first = matches.length ? start + 1 : 0;
                const last = Math.min(start + pageSize, matches.length);
                document.getElementById('draftCount').textContent =
                    first + '–' + last + ' / ' + matches.length + ' taslak';

                renderPager(pageCount);
                updateSelection();
            }

            search.addEventListener('input', () => {
                page = 1;
                renderDrafts();
            });
            document.getElementById('draftSearchClear').addEventListener('click', () => {
                search.value = '';
                page = 1;
                renderDrafts();
                search.focus();
            });

            list.closest('.list-panel').addEventListener('change', event => {
                if (event.target === selectAll) {
                    visibleRows().forEach(row => { checkbox(row).checked = selectAll.checked; });
                }
                updateSelection();
            });

            sortButton.addEventListener('click', () => {
                oldestFirst = !oldestFirst;
                rows().reverse().forEach(row => list.insertBefore(row, empty));
                const label = oldestFirst ? 'Tarih sırası: En eski' : 'Tarih sırası: En yeni';
                sortButton.title = label;
                sortButton.setAttribute('aria-label', label);
                page = 1;
                renderDrafts();
            });

            renderDrafts();
        })();
    </script>
}

