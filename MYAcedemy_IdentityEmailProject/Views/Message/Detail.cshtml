@model MYAcedemy_IdentityEmailProject.Entities.Message

@{
    ViewData["Title"] = Model.Subject;
    var isSent = ViewData["IsSent"] is true;
    ViewData["ActiveMenu"] = isSent ? "sent" : "inbox";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    var contactEmail = isSent ? Model.ReceiverEmail : Model.SenderEmail;
    var initial = string.IsNullOrWhiteSpace(contactEmail)
        ? "?"
        : contactEmail.Substring(0, 1).ToUpper();
}

<section style="max-width: 960px;">
    <article class="panel p-3 p-md-4">
        <header class="pb-3" style="border-bottom: 1px solid var(--border);">
            <h1 class="h4 fw-bold mb-3 text-break">@Model.Subject</h1>

            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="rounded-circle d-grid flex-shrink-0 fw-bold"
                      style="width: 42px; height: 42px; place-items: center;
                             background: var(--lavender); color: var(--accent-dark);"
                      aria-hidden="true">
                    @initial
                </span>

                <div class="flex-grow-1 text-break">
                    <div class="small" style="color: var(--muted);">
                        @(isSent ? "Alıcı" : "Gönderen")
                    </div>
                    <div class="fw-semibold">@contactEmail</div>
                </div>

                <time class="small" style="color: var(--muted);"
                      datetime="@Model.SendDate.ToString("s")">
                    @Model.SendDate.ToString("dd.MM.yyyy HH:mm")
                </time>
            </div>
        </header>

        <div class="pt-4 pb-2"
             style="white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.75;">
            @Model.MessageDetail
        </div>

        <footer class="d-flex flex-wrap gap-2 mt-3 pt-3"
                style="border-top: 1px solid var(--border);">
            @if (!isSent)
            {
                <a asp-controller="Message"
                   asp-action="Reply"
                   asp-route-id="@Model.MessageId"
                   class="btn rounded-pill d-inline-flex align-items-center gap-2"
                   style="background: var(--lavender); color: var(--accent-dark);">
                    <i class="bi bi-reply" aria-hidden="true"></i>
                    Yanıtla
                </a>
            }

            <a asp-controller="Message"
               asp-action="Forward"
               asp-route-id="@Model.MessageId"
               asp-route-sent="@isSent"
               class="btn rounded-pill d-inline-flex align-items-center gap-2"
               style="border: 1px solid var(--border); color: var(--accent-dark);">
                <i class="bi bi-forward" aria-hidden="true"></i>
                İlet
            </a>
        </footer>
    </article>
</section>